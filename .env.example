# Copy to .env (gitignored) and fill in.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode
PROJECT_NUMBER=1
GITHUB_TOKEN=op://Automation/Pyrycode-Dispatcher-PAT/credential
TARGET_REPO_PATH=/absolute/path/to/pyrycode

# Optional
# TARGET_DEFAULT_BRANCH=master   # default: main
# SALVAGE_GATES="go vet ./...; go build ./..."   # default value (Go); set "" to skip gating
# DISCORD_WEBHOOK_URL="op://Automation/Discord webhook/credential"
# CLAUDE_CODE_OAUTH_TOKEN="op://Automation/Claude long term token/password"
# PYRY_LOG_RETENTION_DAYS=30
# OWNER_TYPE=organization   # default: user

# Real-claude gate. The dispatcher runs a ticket's live-claude suite itself
# instead of parking it for an operator. Empty or absent = off, and gated
# tickets park in Inbox exactly as before.
#
# The command MUST emit per-test JSON. A bare `make e2e-realclaude` will not
# do: without -json it prints only a package summary on success, so executed
# tests cannot be counted, and that count is the entire guard. A suite that
# skips everything still exits 0, which is how an unverified change shipped on
# 2026-07-22 (pyrycode PR #1169 / #1168).
# PYRY_REAL_CLAUDE_GATE_CMD=go test -timeout=30m -tags e2e_realclaude -timeout 20m -json ./internal/e2e/realclaude/...
# PYRY_REAL_CLAUDE_GATE_FORMAT=go-json        # or playwright-json
# PYRY_REAL_CLAUDE_GATE_TIMEOUT_MS=1800000    # outer wall clock; exceed the command's own timeout
# PYRY_REAL_CLAUDE_GATE_MIN_EXECUTED=150      # floor; measured 519 passed / 2 failed / 14 skipped on 2026-08-07
#
# Base-commit re-run, used ONLY when the branch run has named failures, so it
# costs seconds. Without it the gate cannot tell "this branch broke it" from
# "it was already broken" and blames the branch for both. Do NOT quote
# {{TESTS}}; the substituted filter brings its own quoting.
# PYRY_REAL_CLAUDE_GATE_BASELINE_CMD=go test -timeout=30m -tags e2e_realclaude -timeout 20m -json -run {{TESTS}} ./internal/e2e/realclaude/...

# AGENTS_REPO_PATH is set automatically by bin/pyry-start.

# Builder-only live repairs reuse the protected Claude login loaded at startup.
# A separate service account that reads only Dev agents is an online fallback.
# PYRY_HEALTH_LIVE_LOGIN_CMD='[ -n "$PYRY_LIVE_CLAUDE_TOKEN" ] || [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ] || op read --no-newline "op://kmzgpgsyeesea3pkiuk2ul2phq/Claude long term token/password" >/dev/null'
# Never use the main Automation account here. Not part of PYRY_AGENT_SHELL_ENV.
# PYRY_DEV_AGENTS_TOKEN="op://Automation/xcl7xsu5ppbww3m5gav7wmbt6e/credential"

# Product maintenance guards run from the target worktree before the product gate.
# Keep independently reportable steps separate. The final verdict waits for all.
# Configure these together after the product checkout has scripts/test-admission.py
# and scripts/check-restoration.py, and dispatcher supports admission provenance.
PYRY_VERIFIER_GATES="$AGENTS_REPO_PATH/bin/pyrycode-tool cite-guard;$AGENTS_REPO_PATH/bin/pyrycode-tool docs-guard;make vet;make test-tools;python3 scripts/test-admission.py -- go test -timeout=30m -race -json ./...;python3 scripts/check-restoration.py;make staticcheck;make substrate-guard;python3 scripts/test-admission.py -- go test -timeout=30m -tags e2e -race -count=1 -json ./internal/e2e/...;make build"
PYRY_VERIFIER_GATE_FORMATS='{"python3 scripts/test-admission.py -- go test -timeout=30m -race -json ./...":{"format":"go-json","baseline":"python3 scripts/test-admission.py -- go test -timeout=30m -race -count=1 -json -run {{TESTS}} ./..."},"python3 scripts/test-admission.py -- go test -timeout=30m -tags e2e -race -count=1 -json ./internal/e2e/...":{"format":"go-json","baseline":"python3 scripts/test-admission.py -- go test -timeout=30m -tags e2e -race -count=1 -json -run {{TESTS}} ./internal/e2e/..."}}'
PYRY_VERIFIER_PARALLEL_REVIEW=1
# Partial retry reuse requires a stable external-input snapshot. The helper
# also rejects modified consumer tooling and records Go toolchain/settings.
PYRY_VERIFIER_GATE_INPUTS_CMD='"$AGENTS_REPO_PATH/bin/verifier-inputs"'

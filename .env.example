# Copy to .env (gitignored) and fill in.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode
PROJECT_NUMBER=1
GITHUB_TOKEN=op://Automation/Pyrycode-Dispatcher-PAT/credential
TARGET_REPO_PATH=/absolute/path/to/pyrycode

# Optional
# TARGET_DEFAULT_BRANCH=master   # default: main
# SALVAGE_GATES="go vet ./...; go build ./..."   # default value (Go); set "" to skip gating
# DISCORD_WEBHOOK_URL="op://Automation/Discord webhook/credential"
# CLAUDE_CODE_OAUTH_TOKEN="op://Automation/Claude long term token/password"
# PYRY_LOG_RETENTION_DAYS=30
# OWNER_TYPE=organization   # default: user

# Real-claude gate. The dispatcher runs a ticket's live-claude suite itself
# instead of parking it for an operator. Empty or absent = off, and gated
# tickets park in Inbox exactly as before.
#
# The command MUST emit per-test JSON. A bare `make e2e-realclaude` will not
# do: without -json it prints only a package summary on success, so executed
# tests cannot be counted, and that count is the entire guard. A suite that
# skips everything still exits 0, which is how an unverified change shipped on
# 2026-07-22 (pyrycode PR #1169 / #1168).
# PYRY_REAL_CLAUDE_GATE_CMD=go test -tags e2e_realclaude -timeout 20m -json ./internal/e2e/realclaude/...
# PYRY_REAL_CLAUDE_GATE_FORMAT=go-json        # or playwright-json
# PYRY_REAL_CLAUDE_GATE_TIMEOUT_MS=1800000    # outer wall clock; exceed the command's own timeout
# PYRY_REAL_CLAUDE_GATE_MIN_EXECUTED=150      # floor; measured 519 passed / 2 failed / 14 skipped on 2026-08-07
#
# Base-commit re-run, used ONLY when the branch run has named failures, so it
# costs seconds. Without it the gate cannot tell "this branch broke it" from
# "it was already broken" and blames the branch for both. Do NOT quote
# {{TESTS}}; the substituted filter brings its own quoting.
# PYRY_REAL_CLAUDE_GATE_BASELINE_CMD=go test -tags e2e_realclaude -timeout 20m -json -run {{TESTS}} ./internal/e2e/realclaude/...

# AGENTS_REPO_PATH is set automatically by bin/pyry-start.

# Copy to .env (gitignored) and fill in.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode
PROJECT_NUMBER=1
GITHUB_TOKEN=ghp_your_token_here
TARGET_REPO_PATH=/absolute/path/to/pyrycode

# Optional
# TARGET_DEFAULT_BRANCH=master   # default: main
# SALVAGE_GATES="go vet ./...; go build ./..."   # default value (Go); set "" to skip gating
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# PYRY_LOG_RETENTION_DAYS=30
# OWNER_TYPE=organization   # default: user

# AGENTS_REPO_PATH is set automatically by bin/pyry-start.

{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_explore",
      "Bash(gh pr merge *)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/gh-board-listing-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

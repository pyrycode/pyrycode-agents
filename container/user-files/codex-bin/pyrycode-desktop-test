#!/usr/bin/env python3
"""Run built Desktop fake-transport tests through a narrow Codex permission."""
import os
from pathlib import Path
import re
import subprocess
import sys

REPOSITORY = Path('/Users/juhanailmoniemi/Workspace/Projects/pyrycode-desktop')
NODE = '/opt/homebrew/bin/node'


def command(args):
    if len(args) not in (1, 2):
        raise ValueError('Usage: pyrycode-desktop-test ABSOLUTE_WORKTREE [e2e/name.spec.ts]')
    candidate = Path(args[0])
    if not candidate.is_absolute():
        raise ValueError('Worktree must be an absolute path')
    worktree = candidate.resolve(strict=True)
    git_env = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
    common = subprocess.run(
        ['/usr/bin/git', '-C', str(worktree), 'rev-parse', '--path-format=absolute', '--git-common-dir'],
        env=git_env, text=True, capture_output=True, check=True
    ).stdout.strip()
    if Path(common).resolve() != (REPOSITORY / '.git').resolve():
        raise ValueError('Only Pyrycode Desktop and its Git worktrees are allowed')
    top = subprocess.run(
        ['/usr/bin/git', '-C', str(worktree), 'rev-parse', '--show-toplevel'],
        env=git_env, text=True, capture_output=True, check=True
    ).stdout.strip()
    if Path(top).resolve() != worktree:
        raise ValueError('Use the worktree root')
    selected = []
    if len(args) == 2:
        spec = args[1]
        if not re.fullmatch(r'e2e/[A-Za-z0-9_-]+\.spec\.ts', spec) or Path(spec).name.startswith('real-'):
            raise ValueError('Use one fake-transport e2e/name.spec.ts path without flags')
        if not (worktree / spec).is_file():
            raise ValueError('The selected spec does not exist')
        selected = [spec]
    cli = worktree / 'node_modules/@playwright/test/cli.js'
    if not cli.is_file() or not (worktree / 'out/main/index.js').is_file():
        raise ValueError('Install dependencies and build the app first')
    return worktree, [NODE, str(cli), 'test', '--config=playwright.config.ts', *selected]


def main():
    try:
        if sys.platform == 'darwin' and os.environ.get('CODEX_SANDBOX') == 'seatbelt':
            raise ValueError('Request approved execution outside the Codex sandbox before running Electron tests')
        worktree, argv = command(sys.argv[1:])
        os.chdir(worktree)
        os.execv(NODE, argv)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'Desktop test launch refused: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())

# Dispatcher settings for the pyrycode container (board 1). Installed as the agents repo's
# .env on every start. No secrets here: GITHUB_TOKEN,
# CLAUDE_CODE_OAUTH_TOKEN and DISCORD_WEBHOOK_URL arrive as Podman secrets.
# Copied from the Mac's .env on 2026-10-03, with container paths and the
# two settings nothing reads any more (PYRY_USE_STREAMJSON, PYRY_RECORD_DIR)
# dropped.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode
PROJECT_NUMBER=1
TARGET_REPO_PATH=/work/Projects/pyrycode

PYRY_STAGE_SET=builder
PYRY_MAX_CONCURRENT=2
PYRY_POLL_INTERVAL_MS=120000
PYRY_FAMILY_DISPATCH_LIMIT=60
PYRY_AUTOCURATE_MEMORY=0
PYRY_MEMORY_LESSON_WATERMARK=14500
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
PYRY_CODEX_MODEL=gpt-6.1-sol

PYRY_VERIFIER_GATES="make check;make build"

# qmd: pyrycode-qmd-refresh.timer reindexes on the host whenever main moves
# (README, "qmd index refresh"), so skip the dispatcher's per-spawn
# `qmd update && qmd embed`, which hit its 120 s limit on every spawn here
# (agent-dispatcher#115). The desktop container does not set this.
PYRY_SKIP_QMD_REFRESH=1

PYRY_REAL_CLAUDE_GATE_CMD="go test -tags e2e_realclaude -timeout 20m -json ./internal/e2e/realclaude/..."
PYRY_REAL_CLAUDE_GATE_FORMAT=go-json
PYRY_REAL_CLAUDE_GATE_TIMEOUT_MS=1800000
# Run the live suite in the background so builders, refiners and documentation
# keep dispatching; only verifiers wait for it. Live on pyrybox since 2026-10-05.
PYRY_REAL_CLAUDE_GATE_BACKGROUND=1
PYRY_REAL_CLAUDE_GATE_MIN_EXECUTED=150
PYRY_REAL_CLAUDE_GATE_BASELINE_CMD="go test -tags e2e_realclaude -timeout 20m -json -run {{TESTS}} ./internal/e2e/realclaude/..."

# Pre-dispatch health checks (agent-dispatcher#131), run once at startup too
# (agent-dispatcher#156). A failing check holds the ticket under
# held:health-check instead of spending an agent run.
PYRY_HEALTH_GITHUB_CMD="gh auth status --hostname github.com"
PYRY_HEALTH_LIVE_LOGIN_CMD='[ -n "$CLAUDE_CODE_OAUTH_TOKEN" ] || op read --no-newline "op://Dev agents/Claude long term token/password" >/dev/null'

# Author of every agent, salvage and merge commit. Read by the entrypoint.
GIT_USER_NAME="Juhana Ilmoniemi"
GIT_USER_EMAIL=juhana@ilmoniemi.fi

# Runner: read before every agent run from /config/runner.json, which is
# ~/pyrycode-runtime/<config folder>/runner.json on pyrybox. Edit it there; no
# restart needed (agent-dispatcher#112). deploy.sh creates it only if missing.
# PYRY_AGENT_RUNNER is the fallback when the file is absent. Codex since
# 2026-10-04 (Juhana); each home has its own Codex device login.
PYRY_RUNNER_FILE=/config/runner.json
PYRY_AGENT_RUNNER=codex

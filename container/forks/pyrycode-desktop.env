# Dispatcher settings for the pyrycode-desktop container (board 7).
# Installed as the desktop agents repo's .env on every start. No secrets
# here: the three secrets are the same Podman secrets the pyrycode container
# uses. Copied from the Mac's .env on 2026-10-04, with container paths,
# PYRY_BIN pointing at the image's pyry, and the two settings nothing reads
# any more (PYRY_USE_STREAMJSON, PYRY_RECORD_DIR) dropped.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode-desktop
PROJECT_NUMBER=7
TARGET_REPO_PATH=/work/Projects/pyrycode-desktop

PYRY_STAGE_SET=builder
PYRY_MAX_CONCURRENT=1
PYRY_POLL_INTERVAL_MS=120000
PYRY_FAMILY_DISPATCH_LIMIT=60
PYRY_AUTOCURATE_MEMORY=0
PYRY_MEMORY_LESSON_WATERMARK=14500
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
PYRY_VERIFIER_PARALLEL_REVIEW=1

# Electron runs under Xvfb here, where a hidden window never paints and
# every e2e screenshot times out. Nobody shares this display, so the tests
# leave the window shown (pyrycode-desktop PR 1740). Never set on the Mac.
PYRY_E2E_SHOW_WINDOW=1

SALVAGE_GATES="npm run build"
PYRY_VERIFIER_GATES="npm install --no-audit --no-fund;npm run check:docs;npm test;npm run build;npx playwright test"
PYRY_VERIFIER_GATE_TIMEOUT_MS=1800000

# The real-claude Playwright specs spawn a real daemon from PYRY_BIN. On the
# Mac this was a hand-built v0.29.0; here it is the image's pinned pyry.
PYRY_BIN=/usr/local/bin/pyry
PYRY_REAL_CLAUDE_GATE_CMD="npm install --no-audit --no-fund >&2 && npm run build >&2 && npx playwright test --config playwright.real-claude.config.ts --reporter=json"
PYRY_REAL_CLAUDE_GATE_FORMAT=playwright-json
PYRY_REAL_CLAUDE_GATE_TIMEOUT_MS=1800000
PYRY_REAL_CLAUDE_GATE_MIN_EXECUTED=10
PYRY_REAL_CLAUDE_GATE_BASELINE_CMD="npm install --no-audit --no-fund >&2 && npm run build >&2 && npx playwright test --config playwright.real-claude.config.ts --reporter=json -g {{TESTS}}"

# Author of every agent, salvage and merge commit. Read by the entrypoint.
GIT_USER_NAME="Juhana Ilmoniemi"
GIT_USER_EMAIL=juhana@ilmoniemi.fi

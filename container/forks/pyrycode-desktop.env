# Dispatcher settings for the pyrycode-desktop container (board 7).
# Installed as the desktop agents repo's .env on every start. No secrets
# here: the three secrets are the same Podman secrets the pyrycode container
# uses. Copied from the Mac's .env on 2026-10-04, with container paths,
# PYRY_BIN pointing at the image's pyry, and the two settings nothing reads
# any more (PYRY_USE_STREAMJSON, PYRY_RECORD_DIR) dropped.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode-desktop
PROJECT_NUMBER=7
TARGET_REPO_PATH=/work/Projects/pyrycode-desktop

PYRY_STAGE_SET=builder
PYRY_MAX_CONCURRENT=2
PYRY_POLL_INTERVAL_MS=120000
PYRY_FAMILY_DISPATCH_LIMIT=60
PYRY_AUTOCURATE_MEMORY=0
PYRY_MEMORY_LESSON_WATERMARK=14500
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
PYRY_VERIFIER_PARALLEL_REVIEW=1

# Electron runs under Xvfb here, where a hidden window never paints and
# every e2e screenshot times out. Nobody shares this display, so the tests
# leave the window shown (pyrycode-desktop PR 1740). Never set on the Mac.
PYRY_E2E_SHOW_WINDOW=1

SALVAGE_GATES="npm run build"
PYRY_VERIFIER_GATES="python3 $AGENTS_REPO_PATH/bin/pre-verify-check --no-suite;npm install --no-audit --no-fund;npm run check:docs;npm test;npm run build;npx playwright test --reporter=json"
PYRY_VERIFIER_GATE_TIMEOUT_MS=1800000
# Gate output read when a gate goes red (agent-dispatcher#133, #142). The
# Playwright tier reports JSON, so the dispatcher reads the failing tests,
# re-runs them once in the same worktree, and sets aside the ones that pass
# there as flaky and the ones that also fail on main. The key must match the
# gate command exactly.
PYRY_VERIFIER_GATE_FORMATS='{"npx playwright test --reporter=json":{"format":"playwright-json","baseline":"npm install --no-audit --no-fund >&2 && npm run build >&2 && npx playwright test --reporter=json -g {{TESTS}}"}}'
# When only docs changed since a green run, only this gate runs again (#134).
PYRY_VERIFIER_DOCS_GATES="npm run check:docs"

# Pre-dispatch health checks (agent-dispatcher#131). A failing check holds
# the ticket under held:health-check instead of spending an agent run. Each
# runs in the environment the agent gets; GitHub's sees the builders' GH_TOKEN.
PYRY_HEALTH_GITHUB_CMD="gh auth status --hostname github.com"
# Figma login of whichever runner runner.json selects by default.
PYRY_HEALTH_FIGMA_CMD="case $(jq -r .runner /config/runner.json 2>/dev/null) in claude) claude mcp list 2>/dev/null | grep -q '^plugin:figma:figma: .*Connected';; *) codex mcp list | grep -Eq '^figma[[:space:]].*[[:space:]]enabled[[:space:]]+OAuth';; esac"
PYRY_HEALTH_LIVE_LOGIN_CMD='[ -n "$CLAUDE_CODE_OAUTH_TOKEN" ] || op read --no-newline "op://Dev agents/Claude long term token/password" >/dev/null'
# Minimum is the image's pinned pyry (Containerfile PYRY_VERSION). Raise both together.
PYRY_HEALTH_DAEMON_CMD="/usr/local/bin/pyry --version"
PYRY_HEALTH_DAEMON_MIN_VERSION=0.36.0

# The real-claude Playwright specs spawn a real daemon from PYRY_BIN. On the
# Mac this was a hand-built v0.29.0; here it is the image's pinned pyry.
PYRY_BIN=/usr/local/bin/pyry
PYRY_REAL_CLAUDE_GATE_CMD="npm install --no-audit --no-fund >&2 && npm run build >&2 && npx playwright test --config playwright.real-claude.config.ts --reporter=json"
PYRY_REAL_CLAUDE_GATE_FORMAT=playwright-json
PYRY_REAL_CLAUDE_GATE_TIMEOUT_MS=1800000
# Run the live suite in the background so builders, refiners and documentation
# keep dispatching; only verifiers wait for it. Live since 2026-10-05.
PYRY_REAL_CLAUDE_GATE_BACKGROUND=1
PYRY_REAL_CLAUDE_GATE_MIN_EXECUTED=10
PYRY_REAL_CLAUDE_GATE_BASELINE_CMD="npm install --no-audit --no-fund >&2 && npm run build >&2 && npx playwright test --config playwright.real-claude.config.ts --reporter=json -g {{TESTS}}"

# Author of every agent, salvage and merge commit. Read by the entrypoint.
GIT_USER_NAME="Juhana Ilmoniemi"
GIT_USER_EMAIL=juhana@ilmoniemi.fi

# Runner: read before every agent run from /config/runner.json, which is
# ~/pyrycode-runtime/<config folder>/runner.json on pyrybox. Edit it there; no
# restart needed (agent-dispatcher#112). deploy.sh creates it only if missing.
# PYRY_AGENT_RUNNER is the fallback when the file is absent. Codex since
# 2026-10-04 (Juhana); each home has its own Codex device login.
PYRY_RUNNER_FILE=/config/runner.json
PYRY_AGENT_RUNNER=codex
PYRY_CODEX_MODEL=gpt-6.1-sol

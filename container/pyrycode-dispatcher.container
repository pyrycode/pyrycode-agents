# Podman Quadlet unit: runs the pyrycode dispatcher container as a systemd
# user service of the pyry account on pyrybox.
#
# Install ONLY at switch-over (README.md): once this file sits in
# ~/.config/containers/systemd/, the dispatcher starts at every boot, and a
# second dispatcher on the same board picks up the same tickets.

[Unit]
Description=pyrycode agent dispatcher (container)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/pyrycode-agent-runtime:latest
ContainerName=pyrycode-dispatcher
UserNS=keep-id
RunInit=true
Volume=%h/pyrycode-runtime/work:/work
Volume=%h/pyrycode-runtime/home:/home/agent
Volume=%h/pyrycode-runtime/config:/config:ro
Secret=pyrycode-github-token,type=env,target=GITHUB_TOKEN
Secret=pyrycode-claude-token,type=env,target=CLAUDE_CODE_OAUTH_TOKEN
Secret=pyrycode-dev-agents-token,type=env,target=PYRY_DEV_AGENTS_TOKEN
Secret=pyrycode-discord-webhook,type=env,target=DISCORD_WEBHOOK_URL
# Leave two of the eight threads to Pyry. A stop drains:
# the dispatcher waits for running agents, which can take most of an hour.
PodmanArgs=--cpus=6 --stop-timeout=3600
Exec=run

[Service]
# Shares one 16 GB memory cap with the other agent container.
Slice=pyrycode-agents.slice
Restart=on-failure
RestartSec=60
TimeoutStartSec=3600
TimeoutStopSec=3700

[Install]
WantedBy=default.target
